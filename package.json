{
  "name": "skiss-playground",
  "private": true,
  "version": "0.3.0",
  "description": "Try Skiss in the browser: write a sketch, see the diagram, share a link.",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "biome check --error-on-warnings",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@eriknaslund/skiss": "0.8.0",
    "mermaid": "^12.1.0"
  }
}
