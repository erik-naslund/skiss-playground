{
  "name": "skiss-playground",
  "private": true,
  "version": "0.1.0",
  "description": "Try Skiss in the browser: write a sketch, see the diagram, share a link.",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "biome check --error-on-warnings",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "jsdom": "^30.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@eriknaslund/skiss": "0.6.1",
    "mermaid": "^12.0.0"
  }
}
